---
import Layout from "../layouts/Layout.astro";

import photo7 from '../imagen/photo7.avif'; 
import photo8 from '../imagen/photo8.avif'; 
---

<Layout 
  title="Grups de Treball i Comunitat - ADOCAT" 
  description="Espais de participació, grups de treball i comissions de l'Associació de Docents Ocupacionals de Catalunya."
>
  <!-- ========================================== -->
  <!-- ОСНОВНОЙ КОНТЕНТ СТРАНИЦЫ (MAIN)          -->
  <!-- ========================================== -->
  <main class="w-full bg-white min-h-screen pb-24">

    <!-- ========================================== -->
    <!-- 1. НАВИГАЦИЯ / ХЛЕБНЫЕ КРОШКИ             -->
    <!-- ========================================== -->
    <nav class="w-full max-w-6xl mx-auto px-6 pt-8 pb-2 text-left" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-2 text-[16px] font-sans tracking-wider uppercase text-stone-400">
        <!-- Главная -->
        <li class="inline-flex items-center">
          <a href="/" class="hover:text-stone-900 transition-colors">Inici</a>
        </li>
        
        <!-- Разделитель-стрелочка -->
        <li class="flex items-center space-x-1 md:space-x-2">
          <span class="text-stone-300 font-light">/</span>
          <a href="/participa" class="hover:text-stone-900 transition-colors">Participa</a>
        </li>
        
        <!-- Текущая страница -->
        <li class="flex items-center space-x-1 md:space-x-2">
          <span class="text-stone-300 font-light">/</span>
          <span class="text-stone-600 font-medium select-none">Comissions</span>
        </li>
      </ol>
    </nav>
      
    <!-- ========================================== -->
    <!-- 2. ВЕРХНИЙ БЛОК: ЗАГОЛОВОК СТРАНИЦЫ        -->
    <!-- ========================================== -->
    <section class="max-w-6xl mx-auto pt-12 md:pt-24 pb-16 px-6 text-center space-y-4">
      <h1 class="text-4xl md:text-5xl font-serif font-normal tracking-tight text-stone-900">
        Grups de Treball i Comunitat
      </h1>
      <p class="text-sm text-stone-500 font-light max-w-2xl mx-auto leading-relaxed">
        Estem definint un catàleg progressiu de recursos, activitats i suport professional. Tria l'espai de l'associació on t'agradaria connectar i compartir la teva experiència.
      </p>
    </section>

    <!-- ========================================== -->
    <!-- 3. КРУПНЫЕ КАРТОЧКИ (2 КОЛОНКИ)           -->
    <!-- ========================================== -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    
        <!-- КАРТОЧКА 1: ОСТАЕТСЯ КАК БЫЛА (В РАЗРАБОТКЕ / EN PREPARACIÓ) -->
        <div class="relative rounded-2xl overflow-hidden bg-stone-950 border border-white/20 shadow-xl min-h-96 flex flex-col items-center justify-center text-center p-6 sm:p-10">
          <div class="absolute inset-0 overflow-hidden">
            <img 
              src={photo7.src} 
              alt="Comunitat i Recursos Docents" 
              class="w-full h-full object-cover opacity-45 transform hover:scale-103 transition-transform duration-700"
            />
          </div>
          <div class="absolute inset-0 bg-linear-to-t from-stone-950/90 via-stone-950/50 to-stone-950/30 z-10"></div>
      
          <div class="relative z-20 max-w-md space-y-3 my-auto">
            <span class="text-[10px] font-bold tracking-[0.25em] uppercase text-stone-300 block">Espai de cooperació</span>
            <h3 class="text-white font-serif text-2xl sm:text-3xl tracking-tight leading-tight">
              Comunitat i Recursos
            </h3>
            <p class="text-stone-200/90 text-sm font-light leading-relaxed">
              Un espai viu per compartir materials didàctics, bones pràctiques i experiències de teleformació o presencials. Construïm una xarxa de suport mutu.
            </p>
            <div class="pt-2">
              <span class="inline-block bg-white hover:bg-stone-100 text-stone-950 px-6 py-3 text-xs font-semibold tracking-widest uppercase transition-all shadow-md rounded-xs select-none">
                En preparació &rarr;
              </span>
            </div>
          </div>
        </div>

        <!-- КАРТОЧКА 2: КОМИССИИ (С КНОПКОЙ-ПЕРЕХОДОМ НА ФОРМУ) -->
        <div class="relative rounded-2xl overflow-hidden bg-stone-950 border border-white/20 shadow-xl min-h-96 flex flex-col items-center justify-center text-center p-6 sm:p-10">
          <div class="absolute inset-0 overflow-hidden">
            <img 
              src={photo8.src} 
              alt="Comissions d'Implicació Professional" 
              class="w-full h-full object-cover opacity-45 transform hover:scale-103 transition-transform duration-700"
            />
          </div>
          <div class="absolute inset-0 bg-linear-to-t from-stone-950/90 via-stone-950/50 to-stone-950/30 z-10"></div>

          <div class="relative z-20 max-w-md space-y-3 my-auto">
            <span class="text-[10px] font-bold tracking-[0.25em] uppercase text-stone-300 block">Eix d'actuació oficial</span>
            <h3 class="text-white font-serif text-2xl sm:text-3xl tracking-tight leading-tight">
              Comissions de Treball
            </h3>
            <p class="text-stone-200/90 text-sm font-light leading-relaxed">
              Grups dedicats a analitzar la normativa vigent, impulsar propostes de millora davant les administracions i defensar el reconeixement de la professió.
            </p>
            
            <!-- Добавленный по ТЗ текст и интерактивная кнопка -->
            <div class="pt-2 space-y-3">
              <p class="text-stone-300 text-xs font-medium leading-relaxed">
                Vols aportar idees o col·laborar en un grup de treball? Deixa’ns les teves dades i t’informarem dels passos per participar-hi.
              </p>
              <div>
                <a 
  href="/participa?role=comissio#quiz-section" 
  class="inline-block bg-[#21bf63] hover:bg-emerald-600 text-white px-6 py-3 text-xs font-black tracking-widest uppercase transition-all shadow-md rounded-xs cursor-pointer text-center">
  M’interessa participar en una comissió &rarr;
</a>
              </div>
            </div>
          </div>
        </div>

    </div>
</section>

  </main>

 <script src="../js/info.js"></script>
</Layout>

