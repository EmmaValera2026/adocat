---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Panell de Control - ADOCAT" 
  description="Plataforma interactiva d'ADOCAT per compartir la realitat del col·lectiu docent a Catalunya. Apte per a professors del SOC, formadors en línia, teleformació, tutors pedagògics, orientadors i professionals en cerca de centre de Formació per a l'Ocupació. Unifica les necessitats sectorials i prioritats del sector."
>
  <!-- ========================================== -->
  <!-- ОСНОВНОЙ КОНТЕНТ СТРАНИЦЫ (MAIN)          -->
  <!-- ========================================== -->
  <main class="w-full bg-gray-50 min-h-screen py-12">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      
      <!-- ========================================== -->
      <!-- ЦЕНТРАЛЬНЫЙ БЛОК АДМИН-ПАНЕЛИ            -->
      <!-- ========================================== -->
      <div id="modal-card" class="w-full bg-white border border-gray-200 rounded-sm p-5 md:p-8 shadow-md flex flex-col text-brand-dark relative">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-brand-green"></div>
        
        <!-- Шапка панели управления -->
        <header class="flex items-center justify-between border-b border-gray-200 pb-4 shrink-0 mt-2">
          <div class="flex items-center gap-3">
            <span class="text-2xl">📊</span>
            <div class="text-left">
              <h3 class="text-xl font-black text-brand-dark uppercase tracking-tight">Panell de Control de Gestió</h3>
              <p class="text-xs text-gray-500 font-medium">Administració central de registres i gestió de l'associació</p>
            </div>
          </div>
          <a href="/" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xs text-xs font-bold transition-colors">
            Tornar a l'Inici &times;
          </a>
        </header>
        
        <div class="flex-1 space-y-6 py-4">
            
          <!-- ========================================== -->
          <!-- 1. ФОРМА АВТОРИЗАЦИИ АДМИНИСТРАТОРА        -->
          <!-- ========================================== -->
          <section id="admin-login-block" class="max-w-sm mx-auto text-center py-12 space-y-4">
            <p class="text-sm text-gray-600 font-semibold uppercase tracking-wider">Accés Restringit Administrador</p>
            <div class="flex flex-col gap-3 justify-center">
              <input type="password" id="admin-password-input" class="w-full bg-gray-50 border-2 border-gray-200 p-3 rounded-xs font-semibold text-sm outline-none text-brand-dark focus:border-brand-green transition-colors" placeholder="Introduïu la contrasenya...">
              <button id="submit-password-btn" class="bg-brand-green hover:bg-brand-hover font-black text-xs uppercase tracking-widest text-white px-5 py-4 rounded-xs cursor-pointer transition-all shadow-xs">Entrar al Sistema &rarr;</button>
            </div>
            <p id="login-error-msg" class="text-xs text-rose-600 hidden font-bold uppercase tracking-wider">⚠️ Contrasenya incorrecta.</p>
          </section>

          <!-- ========================================== -->
          <!-- 2. ОСНОВНОЙ КОНТЕНТ (СКРЫТ ДО ПАРОЛЯ)      -->
          <!-- ========================================== -->
          <div id="admin-content-block" class="hidden space-y-6">
              
            <!-- 📊 СЕТКА МЕТРИК -->
            <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 text-center select-none pt-2">
              <div class="bg-gray-50 border border-gray-200 p-4 rounded-xs shadow-xs">
                <span class="text-[10px] font-black uppercase tracking-wider text-gray-400 block mb-1">Total Registres</span>
                <span id="metric-total" class="text-2xl font-black text-brand-dark">0</span>
              </div>
              <div class="bg-blue-50/40 border border-blue-100 p-4 rounded-xs shadow-xs">
                <span class="text-[10px] font-black uppercase tracking-wider text-blue-600 block mb-1">Només Registre</span>
                <span id="metric-only-reg" class="text-2xl font-black text-blue-600">0</span>
              </div>
              <div class="bg-emerald-50/50 border border-emerald-100 p-4 rounded-xs shadow-xs">
                <span class="text-[10px] font-black uppercase tracking-wider text-brand-green block mb-1">Persones Associades</span>
                <span id="metric-socios" class="text-2xl font-black text-brand-green">0</span>
              </div>
              <div class="bg-purple-50/40 border border-purple-100 p-4 rounded-xs shadow-xs">
                <span class="text-[10px] font-black uppercase tracking-wider text-purple-700 block mb-1">Amics PADA</span>
                <span id="metric-padas" class="text-2xl font-black text-purple-700">0</span>
              </div>
              <div class="bg-amber-50/40 border border-amber-200 p-4 rounded-xs shadow-xs">
                <span class="text-[10px] font-black uppercase tracking-wider text-amber-700 block mb-1">Comissions / Entitats</span>
                <span id="metric-colaboradores" class="text-2xl font-black text-amber-700">0</span>
              </div>
            </section>

            <!-- 🛠️ БЛОК ФИЛЬТРОВ И СОРТИРОВКИ -->
            <section class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 bg-gray-50 p-4 rounded-xs border border-gray-200">
                
              <!-- Левая часть: Кнопки фильтрации -->
              <div class="flex flex-col gap-3 w-full lg:w-auto text-left">
                  
                <!-- Ряд 1: Переключатель общеий -->
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-xs font-black uppercase text-gray-500 tracking-wider mr-2">Filtrar per implicació:</span>
                  <button class="filter-role-btn px-4 py-2 text-[10px] font-extrabold rounded-xs border-2 border-brand-green bg-brand-green text-white cursor-pointer transition-all uppercase tracking-wider" data-role="all">
                    Tots els perfils
                  </button>
                </div>
  
                <!-- Ряд 2: Конкретные формы участия -->
                <div class="flex flex-wrap gap-2 text-[10px] font-extrabold uppercase tracking-wider">
                  <button class="filter-role-btn px-3 py-2 rounded-xs border-2 border-gray-200 bg-white text-gray-600 hover:border-gray-300 cursor-pointer transition-all" data-role="only-reg">Només registre</button>
                  <button class="filter-role-btn px-3 py-2 rounded-xs border-2 border-gray-200 bg-white text-gray-600 hover:border-gray-300 cursor-pointer transition-all" data-role="socio">Sòcia</button>
                  <button class="filter-role-btn px-3 py-2 rounded-xs border-2 border-gray-200 bg-white text-gray-600 hover:border-gray-300 cursor-pointer transition-all" data-role="pada">PADA</button>
                  <button class="filter-role-btn px-3 py-2 rounded-xs border-2 border-gray-200 bg-white text-gray-600 hover:border-gray-300 cursor-pointer transition-all" data-role="comissio">Comissió</button>
                  <button class="filter-role-btn px-3 py-2 rounded-xs border-2 border-gray-200 bg-white text-gray-600 hover:border-gray-300 cursor-pointer transition-all" data-role="entitat">Entitat</button>
                  <button class="filter-role-btn px-3 py-2 rounded-xs border-2 border-gray-200 bg-white text-gray-600 hover:border-gray-300 cursor-pointer transition-all" data-role="butlleti">Butlletí</button>
                </div>   
              </div>

              <!-- Правая часть: Сортировка и Экспорт CSV -->
              <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 w-full lg:w-auto justify-end pt-2 lg:pt-0">
                <span class="text-xs font-black uppercase text-gray-500 tracking-wider">Ordena per:</span>
                <select id="sort-leads-select" class="bg-white border-2 border-gray-200 p-2 rounded-xs text-xs font-bold text-gray-700 outline-none focus:border-brand-green cursor-pointer">
                  <option value="date-desc" selected>Data: Més recents primer</option>
                  <option value="date-asc">Data: Més antics primer</option>
                  <option value="name-asc">Nom: Alfabètic (A-Z)</option>
                </select>
                <button id="export-csv-btn" class="bg-brand-dark text-white px-4 py-2.5 rounded-xs text-xs font-black uppercase tracking-wider hover:bg-black transition-colors cursor-pointer shadow-xs flex items-center gap-1.5">
                  📥 Exportar CSV
                </button>
              </div>

            </section>

            <!-- 📑 ВКЛАДКИ УПРАВЛЕНИЯ -->
            <nav class="flex flex-col md:flex-row items-stretch md:items-center gap-2 w-full p-4 border-b border-gray-100 pb-4 mb-6">
              <button id="tab-btn-complaints" class="px-5 py-2 text-xs font-black rounded-xs border-2 border-brand-green bg-brand-green text-white cursor-pointer transition-all uppercase tracking-wider shadow-xs">
                💼 Consultes i incidències
              </button>
              <button id="tab-btn-support" class="px-5 py-2 text-xs font-black rounded-xs border-2 border-gray-200 bg-white text-gray-600 hover:border-gray-300 cursor-pointer transition-all uppercase tracking-wider shadow-xs">
                🆘 Suport General
              </button>
              <a href="/admin" target="_blank" class="px-4 py-2 border border-blue-200 bg-blue-50 text-blue-700 hover:bg-blue-100 font-black text-xs uppercase tracking-wider rounded-xs transition-colors cursor-pointer inline-flex items-center gap-1.5 shadow-sm md:ml-auto">
                ✍️ Gestionar Contingut (CMS)
              </a>
            </nav>

            <!-- 🖥️ ТАБЛИЦА РЕГИСТРАЦИЙ (ДЛЯ ДЕСКТОПА) -->
            <section class="hidden md:block overflow-x-auto border border-gray-200 rounded-xs">
              <table class="w-full text-left border-collapse text-sm">
                <thead>
                  <tr class="bg-gray-50 border-b border-gray-200 text-xs font-black uppercase text-gray-500 tracking-wider">
                    <th class="p-4">Data</th>
                    <th class="p-4">Nom complet</th>
                    <th class="p-4">Email</th>
                    <th class="p-4">Telèfon</th>
                    <th class="p-4">Modalitat Implicació</th>
                    <th class="p-4 text-center">Expedient</th>
                  </tr>
                </thead>
                <tbody id="leads-table-body" class="divide-y divide-gray-200 bg-white"></tbody>
              </table>
            </section>

            <!-- 📱 СПИСОК КАРТОЧЕК (ДЛЯ МОБИЛЬНЫХ) -->
            <section id="leads-mobile-list" class="block md:hidden space-y-4"></section>
          </div>

        </div>
      </div>
    </div>
  </main>

  <!-- ========================================== -->
  <!-- 3. МОДАЛЬНЫЕ ОКНА                         -->
  <!-- ========================================== -->

  <!-- 👁️ МОДАЛЬНОЕ ОКНО: ОТВЕТЫ КВИЗА -->
  <div id="answers-modal" class="fixed inset-0 bg-gray-900/40 backdrop-blur-xs flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300 z-50">
    <div id="answers-modal-card" class="w-full max-w-2xl bg-white border border-gray-200 rounded-sm p-6 md:p-8 shadow-2xl transform scale-95 transition-all duration-300 space-y-6 text-left text-brand-dark">
        
      <div class="flex items-center justify-between border-b-2 border-gray-800 pb-3">
        <div>
          <h4 class="font-sans font-black text-lg uppercase tracking-tight text-gray-900">Historial de necessitats docents</h4>
          <p id="ans-modal-lead-info" class="text-xs font-bold text-brand-green uppercase tracking-wider mt-0.5"></p>
        </div>
        <button id="close-answers-btn" class="font-bold text-gray-400 hover:text-brand-dark cursor-pointer text-2xl border-none bg-transparent">&times;</button>
      </div>
      
      <div id="ans-modal-container" class="space-y-4 max-h-[50vh] overflow-y-auto py-2 text-base font-medium text-gray-700 divide-y divide-gray-100">
        <!-- JS вставит ответы -->
      </div>
      
      <div class="pt-2 border-t border-gray-100">
        <button id="close-answers-bottom-btn" class="w-full bg-gray-100 hover:bg-gray-200 text-brand-dark font-black text-xs uppercase tracking-widest py-4 rounded-xs transition-colors cursor-pointer border border-gray-200 shadow-xs">
          Tancar expedient
        </button>
      </div>
    </div>
  </div>

  <!-- 📱 МОДАЛЬНОЕ ОКНО: ОБЩИЕ ДЕТАЛИ -->
  <div id="cta-modal" class="fixed inset-0 bg-gray-900/40 backdrop-blur-xs flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300 z-50 overflow-y-auto">
    <div id="cta-modal-card" class="w-full max-w-4xl max-h-[90vh] overflow-y-auto bg-white border border-gray-200 rounded-sm p-6 shadow-2xl transform scale-95 transition-all duration-300 space-y-4 text-left text-brand-dark">
        
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <h4 id="cta-modal-title" class="text-lg font-black text-brand-dark uppercase tracking-tight">
          <!-- JS вставит заголовок -->
        </h4>
        <button id="close-cta-modal-btn" class="text-gray-400 hover:text-brand-dark cursor-pointer text-xl font-bold border-none bg-transparent">&times;</button>
      </div>
      
      <div id="cta-modal-text" class="text-sm text-gray-600 leading-relaxed font-medium space-y-2">
        <!-- JS вставит текст -->
      </div>
      
      <div class="pt-2">
        <button id="close-cta-modal-bottom-btn" class="w-full bg-gray-100 hover:bg-gray-200 text-brand-dark font-black text-xs uppercase tracking-widest py-3.5 rounded-xs transition-colors cursor-pointer border border-gray-200 shadow-xs">
          Tancar finestra
        </button>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 4. HTML-ШАБЛОНЫ (DOM TEMPLATES)           -->
  <!-- ========================================== -->
  
  <!-- Шаблон строки таблицы ПК -->
  <template id="table-row-template">
    <tr class="hover:bg-gray-50/80 transition-colors">
      <td class="p-4 text-gray-500 font-medium td-date"></td>
      <td class="p-4 font-bold text-brand-dark td-name"></td>
      <td class="p-4 text-gray-600 font-medium td-email"></td>
      <td class="p-4 text-gray-600 font-mono td-phone"></td>
      <td class="p-4"><span class="td-badge px-2 py-1 text-[10px] font-black rounded-xs uppercase tracking-wider"></span></td>
      <td class="p-4 text-center">
        <button class="view-answers-btn px-4 py-2 text-xs font-black bg-brand-green hover:bg-brand-hover text-white rounded-xs transition-all cursor-pointer uppercase tracking-wider shadow-xs">👀 Ver</button>
      </td>
    </tr>
  </template>

  <!-- Шаблон карточки инцидента для мобильных -->
  <template id="complaint-card-template">
    <div class="bg-white border border-gray-200 p-4 rounded-xs shadow-xs relative overflow-hidden space-y-3 text-left">
      <div class="absolute top-0 left-0 bottom-0 w-1 bg-brand-dark"></div>
      <div class="flex justify-between items-center text-[10px] font-bold text-gray-400 uppercase tracking-wider">
        <span class="comp-card-date"></span>
        <span class="px-2 py-0.5 bg-gray-100 text-gray-700 border border-gray-200 rounded-xs">INCIDÈNCIA</span>
      </div>
      <div class="space-y-1">
        <h4 class="text-sm font-black text-brand-dark uppercase tracking-tight comp-card-centre"></h4>
        <p class="text-xs text-gray-500 font-semibold comp-card-type"></p>
      </div>
      <div class="pt-2 border-t border-gray-100 flex justify-between items-center text-xs">
        <p class="text-gray-400 font-medium">Contacte: <span class="text-brand-dark font-bold comp-card-contact"></span></p>
        <button class="view-complaint-btn text-[10px] font-black uppercase tracking-widest text-brand-dark hover:text-brand-green transition-colors">
          Llegir &rarr;
        </button>
      </div>
    </div>
  </template>

  <!-- Шаблон обычной карточки для мобильных -->
  <template id="mobile-card-template">
    <div class="bg-white p-5 rounded-xs border border-gray-200 shadow-xs space-y-3 text-left relative overflow-hidden">
      <div class="absolute top-0 left-0 bottom-0 w-1 bg-brand-green card-side-line"></div>
      <div class="flex justify-between items-center border-b border-gray-100 pb-2">
        <span class="card-date text-xs text-gray-400 font-semibold"></span>
        <span class="card-badge px-2 py-0.5 text-[9px] font-black rounded-xs uppercase tracking-wider"></span>
      </div>
      <p class="card-name font-black text-brand-dark text-base"></p>
      <div class="text-xs space-y-1 text-gray-600 font-medium">
        <p>Email: <span class="card-email text-brand-dark"></span></p>
        <p>Tel: <span class="card-phone text-brand-dark font-mono"></span></p>
      </div>
      <button class="view-answers-btn w-full mt-2 px-4 py-3 text-xs font-black bg-brand-green hover:bg-brand-hover text-white rounded-xs cursor-pointer uppercase tracking-widest shadow-xs">👀 Veure respostes</button>
    </div>
  </template>

  <!-- ========================================== -->
  <!-- 5. СКРИПТЫ СТРАНИЦЫ                       -->
  <!-- ========================================== -->
  <script src="../js/menu.js"></script>
  <script src="../js/info.js"></script>
</Layout>